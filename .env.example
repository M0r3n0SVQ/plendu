# Required — OpenAI API key with access to gpt-4o-mini (vision).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — Upstash Redis for distributed rate limiting AND the "sync
# between devices" feature (a code-based, account-free way to carry your
# historial to another device — see app/api/sync/route.ts).
# Without these: rate limiting falls back to a per-instance in-memory
# limiter (fine for local dev, bypassable on Vercel serverless), and the
# sync feature is disabled outright (503) rather than degrading silently.
# Create a free Redis DB at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional — the domain this deployment is actually reachable at, used for
# metadataBase, canonical URLs, the sitemap and robots.txt. Without this it
# defaults to the live Vercel URL (see app/lib/siteUrl.ts) so those never
# point at an unregistered/unconfigured domain.
NEXT_PUBLIC_SITE_URL=https://plendu.app

# Optional — Sentry error monitoring (free up to 5k events/month).
# Without this, Sentry no-ops and the app behaves identically.
# Create a project at https://sentry.io → copy the DSN from Settings → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oXXXX.ingest.sentry.io/XXXX

# Optional — only needed if you want sourcemap uploads at build time
# (better stack traces in Sentry). Generate at sentry.io → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
